# Application
NODE_ENV=test
PORT=3002
SOCKET_PORT=3003
API_URL=http://localhost:3002
TRUST_PROXY=false
LOG_LEVEL=silent

# Database (test compose uses port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_test

# Redis (test compose uses port 6380)
REDIS_URL=redis://localhost:6380

# JWT
JWT_ACCESS_SECRET=test-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=test-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_SID_COOKIE_NAME=csrf_sid
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF
CSRF_SECRET=test-csrf-secret-min-32-chars-long!!!!

# CORS
CORS_ORIGINS=http://localhost:3000

# SMTP (Mailpit or similar for local testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=test@example.com

# API Documentation
API_DOCS_PATH=/api/docs

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=express-backend-template-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
